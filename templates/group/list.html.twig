{% extends 'base.html.twig' %}

{% block title %}Liste des Groupes
{% endblock %}

{% block body %}
	<div class="container mt-5 mb-5">

		<h1 class="text-center mb-4">Liste des Groupes</h1>

		<!-- Boutons Actions -->
		<div class="text-center mb-5">
			<a href="{{ path('app_generate_groups') }}" class="btn btn-outline-primary rounded-pill px-4 py-2">Mettre à jour les groupes</a>
		</div>

		<!-- Mes Groupes -->
		<div class="mb-5">
			<h2 class="mb-4">Mes Groupes</h2>
			{% if userGroups is empty %}
				<p class="text-muted text-center">Vous n'êtes dans aucun groupe.</p>
			{% else %}
				<div class="card shadow-lg" style="max-width: 550px; border-radius: 20px;">
					<div class="card-body ">
						{% for group in userGroups %}
							<div class="mb-5 text-primary">
								<h3>{{ group.nom }}</h3>
								<p>
									<strong class="text-primary">Projet :</strong>
									{{ group.projet.intitule }}</p>

								<h4 class="h6 text-muted">Membres :</h4>
								<ul class="list-group">
									{% for member in group.users %}
										<li class="list-group-item d-flex align-items-center">
											{% if member.profilePicture %}
												<img src="{{ asset('uploads/profile_pictures/' ~ member.profilePicture) }}" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;" alt="Photo de profil">
											{% else %}
												<img src="{{ asset('assets/img/default-profile.png') }}" alt="Photo de profil" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;">
											{% endif %}
											<a href="{{ path('app_user_profile', {'id': member.id}) }}" class="text-decoration-none">{{ member.username }}</a>
										</li>
									{% endfor %}
								</ul>
							</div>
						{% endfor %}
					</div>
				</div>
			{% endif %}
		</div>

		<!-- Tous les Groupes -->
		<div>
			<h2 class="mb-4">Tous les Groupes</h2>
			{% if allGroups is empty %}
				<p class="text-muted text-center">Aucun groupe disponible.</p>
			{% else %}
				<div class="card shadow-lg" style="max-width: 550px; border-radius: 20px;">
					<div class="card-body">
						{% for group in allGroups %}
							<div class="mb-5 text-primary">
								<h3>{{ group.nom }}</h3>
								<p>
									<strong class="text-primary">Projet :</strong>
									{{ group.projet.intitule }}</p>

								<h4 class="h6 text-muted">Membres :</h4>
								<ul class="list-group">
									{% for member in group.users %}
										<li class="list-group-item d-flex align-items-center">
											{% if member.profilePicture %}
												<img src="{{ asset('uploads/profile_pictures/' ~ member.profilePicture) }}" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;" alt="Photo de profil">
											{% else %}
												<img src="{{ asset('assets/img/default-profile.png') }}" alt="Photo de profil" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;">
											{% endif %}
											<a href="{{ path('app_user_profile', {'id': member.id}) }}" class="text-decoration-none">{{ member.username }}</a>
										</li>
									{% endfor %}
								</ul>
							</div>
						{% endfor %}
					</div>
				</div>
			{% endif %}
		</div>
	</div>
{% endblock %}
