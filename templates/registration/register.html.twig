{% extends 'base.html.twig' %}

{% block title %}Register
{% endblock %}

{% block body %}
    <div class="container d-flex justify-content-center mt-5 mb-5 vh-100">
        <div class="card p-4 shadow" style="width: 600px; height: auto;">
            <h1 class="h2 text-center">Inscription</h1>

            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm) }}
            
            <div class="mb-3 row">
                <div class="col-6">
                    {{ form_row(registrationForm.firstname, {
                        label: 'Prénom',
                        attr: { class: 'form-control' }
                    }) }}
                </div>
                <div class="col-6">
                    {{ form_row(registrationForm.lastname, {
                        label: 'Nom',
                        attr: { class: 'form-control' }
                    }) }}
                </div>
            </div>

            <div class="mb-3">
                {{ form_row(registrationForm.username, {
                    label: 'Pseudo',
                    attr: { class: 'form-control' }
                }) }}
            </div>

            <div class="mb-3">
                {{ form_row(registrationForm.biographie, {
					label: 'Biographie',
                    attr: { class: 'form-control' }
                }) }}
            </div>

            <div class="mb-3">
                {{ form_row(registrationForm.email, {
                    attr: { class: 'form-control' }
                }) }}
            </div>

            <div class="mb-3">
                {{ form_row(registrationForm.plainPassword, {
                    label: 'Mot de passe',
                    attr: { class: 'form-control' }
                }) }}
            </div>

            <div class="mb-3">
                {{ form_row(registrationForm.profilePicture, {
					label: 'Photo de profil',
                    attr: { class: 'form-control' }
                }) }}
            </div>

            <div class="mb-3 form-check">
                {{ form_row(registrationForm.agreeTerms, {
					label: 'J\'accepte les conditions d\'utilisation',
                    attr: { class: 'form-check-input' }
                }) }}
            </div>

            <button type="submit" class="btn btn-primary w-auto mx-auto d-block">S'inscrire</button>
            
            {{ form_end(registrationForm) }}
        </div>
    </div>
{% endblock %}
