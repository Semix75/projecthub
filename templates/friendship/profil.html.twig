{% extends 'base.html.twig' %}

{% block title %}Profil de
	{{ user.username }}
{% endblock %}

{% block body %}
	<div class="container mt-5 mb-5">

		<div class="card shadow-lg mx-auto" style="max-width: 600px; min-height: 650px; border-radius: 20px;">
			<div class="card-body d-flex flex-column justify-content-between">

				<div>
					<h1 class="text-center mb-4">Profil de
						{{ user.username }}</h1>

					<div class="text-center mb-4">
						{% if user.profilePicture %}
							<img src="{{ asset('uploads/profile_pictures/' ~ user.profilePicture) }}" class="rounded-circle shadow" style="width: 150px; height: 150px; object-fit: cover;" alt="Photo de profil">
						{% else %}
							<img src="{{ asset('images/default-profile.png') }}" class="rounded-circle shadow" style="width: 150px; height: 150px; object-fit: cover;" alt="Photo par défaut">
						{% endif %}
					</div>

					<ul class="list-group list-group-flush">
						<li class="list-group-item py-3">
							<strong>Email :</strong>
							{{ user.email }}</li>
						<li class="list-group-item py-3">
							<strong>Nom :</strong>
							{{ user.lastname }}</li>
						<li class="list-group-item py-3">
							<strong>Prénom :</strong>
							{{ user.firstname }}</li>
						<li class="list-group-item py-3">
							<strong>Biographie :</strong>
							{{ user.biographie ?: 'Aucune biographie' }}</li>
					</ul>
				</div>

				<div>
					{% if user.id != app.user.id %}
						<div class="text-center mt-4">

							{% if isFriend %}
								<h4 class="text-success mb-4">Vous êtes amis</h4>
								<div class="d-flex justify-content-center gap-3">
									<form action="{{ path('app_remove_friend', {userId: user.id}) }}" method="POST">
										<button type="submit" class="btn btn-outline-secondary rounded-pill px-4 py-2">Supprimer l'ami</button>
									</form>
									<form action="{{ path('app_block_friend', {userId: user.id}) }}" method="POST">
										<button type="submit" class="btn btn-outline-danger rounded-pill px-4 py-2">Bloquer</button>
									</form>
								</div>

							{% elseif pendingRequest is defined and pendingRequest %}
								<h4 class="text-warning">Demande en attente</h4>
								<p class="text-muted">Vous avez envoyé une demande d'ami.</p>

							{% elseif receivedRequest is defined and receivedRequest %}
								<h4 class="text-info">Demande reçue</h4>
								<form action="{{ path('app_accept_friend', {id: user.id}) }}" method="POST" class="mt-3">
									<button type="submit" class="btn btn-success rounded-pill px-4 py-2">Accepter</button>
								</form>

							{% else %}
								<h4 class="text-danger">Vous n'êtes pas encore amis</h4>
								<form method="POST" action="{{ path('app_add_friend', {userId: user.id}) }}" class="mt-3">
									<button type="submit" class="btn btn-primary rounded-pill px-4 py-2">Envoyer une demande d'ami</button>
								</form>
							{% endif %}

						</div>
					{% else %}
						<p class="text-center mt-4 text-muted">Ceci est votre profil.</p>
					{% endif %}
				</div>

				<div class="text-center mt-4">
					<a href="{{ path('app_friends_list') }}" class="btn btn-outline-primary rounded-pill px-4 py-2">
						Retour à la liste d'amis
					</a>
				</div>

			</div>
		</div>


	</div>
{% endblock %}
