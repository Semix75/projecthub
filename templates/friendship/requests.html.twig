{% extends 'base.html.twig' %}

{% block title %}Demandes d'amis
{% endblock %}

{% block body %}
	<div class="container mt-5">
		{% if is_granted('IS_AUTHENTICATED_FULLY') %}
			<h1 class="text-center mb-4">Demandes d'amis</h1>

			{% if requests is empty %}
				<p class="text-muted text-center">Aucune demande d'ami reçue.</p>
			{% else %}
				<div class="card shadow-lg">
					<div class="card-body">
						<ul class="list-group">
							{% for request in requests %}
								<li class="list-group-item d-flex justify-content-between align-items-center">
									<div
										class="d-flex align-items-center">
										<!-- Affichage de la photo de profil de la personne qui envoie la demande -->
										{% if request.requester.profilePicture %}
											<img src="{{ asset('uploads/profile_pictures/' ~ request.requester.profilePicture) }}" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;" alt="Photo de profil">
										{% else %}
											<img src="{{ asset('assets/img/default-profile.png') }}" alt="Photo de profil" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;">
										{% endif %}
										<span>{{ request.requester.email }}</span>
									</div>
									<div>
										<a href="{{ path('app_accept_friend', { id: request.id }) }}" class="btn btn-success btn-sm">✅ Accepter</a>
										<a href="{{ path('app_decline_friend', { id: request.id }) }}" onclick="return confirm('Voulez-vous vraiment refuser cette demande ?')" class="btn btn-danger btn-sm">❌ Refuser</a>
									</div>
								</li>
							{% endfor %}

						</ul>
					</div>
				</div>
			{% endif %}

		{% else %}
			<p class="text-center text-danger">⚠️ Vous devez être connecté pour voir cette page.</p>
		{% endif %}

		<!-- Bouton retour centré -->
		<div class="text-center mt-5">
			<a href="{{ path('app_friends_list') }}" class="btn btn-outline-primary rounded-pill px-4 py-2">
				Retour à la liste d'amis
			</a>
		</div>
	</div>
{% endblock %}
