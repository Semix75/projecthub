<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>Nouveau message de contact</title>
	</head>
	<body style="font-family: Arial, sans-serif; background-color: #f4f4f4; margin: 0; padding: 20px;">
		<div style="max-width: 600px; background: #ffffff; padding: 20px; border-radius: 10px; box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1); margin: auto;">
			<h2 style="color: #333; border-bottom: 2px solidrgb(0, 123, 255); padding-bottom: 10px;">📩 Nouveau message de
				<span style="color: rgb(70, 100, 133)">{{ name }}</span></h2>

			<p>
				<strong>✉️ Email :</strong>
				{{ user_email }}</p>

			<p>
				<strong>📝 Message :</strong>
			</p>
			<p style="color: #555; line-height: 1.5;">{{ message|nl2br }}</p>

			<div style="margin-top: 20px; text-align: center; font-size: 12px; color: #888;">
				<p>Ce message a été envoyé via le formulaire de contact.</p>
			</div>
		</div>
	</body>
</html>
