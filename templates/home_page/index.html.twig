{% extends 'base.html.twig' %}

{% block title %}Bienvenue sur ProjectHub{% endblock %}

{% block body %}
	<!-- Masthead-->
	<header class="masthead" style="padding-top: 8rem; padding-bottom: 8rem;">
		<div class="overlay"></div>
		<div class="container text-center text-white position-relative">
			<h1 class="display-4 fw-bold">ProjectHub</h1>
			<p class="lead fs-4">Découvrez et choisissez le projet qui vous plaît !</p>
		</div>
	</header>

	<!-- Fonctionnalités clés -->
	<section class="py-5 bg-light">
		<div class="container">
			<h2 class="text-center mb-5">Pourquoi utiliser ProjectHub ?</h2>
			<div class="row text-center">
				<div class="col-md-4 mb-4">
					<div class="card h-100 shadow-sm border-0">
						<div class="card-body">
							<h5 class="card-title">🎓 Choix des élèves</h5>
							<p class="card-text">Les étudiants sélectionnent leurs 5 projets préférés en un clic.</p>
						</div>
					</div>
				</div>
				<div class="col-md-4 mb-4">
					<div class="card h-100 shadow-sm border-0">
						<div class="card-body">
							<h5 class="card-title">🧑‍🏫 Interface professeurs</h5>
							<p class="card-text">Les enseignants proposent facilement leurs sujets avec un suivi complet.</p>
						</div>
					</div>
				</div>
				<div class="col-md-4 mb-4">
					<div class="card h-100 shadow-sm border-0">
						<div class="card-body">
							<h5 class="card-title">⚙️ Attribution intelligente</h5>
							<p class="card-text">Un algorithme équitable affecte les projets selon les préférences et les places disponibles.</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Comment ça marche ? -->
	<section class="py-5 bg-white">
		<div class="container">
			<h2 class="text-center mb-5">Comment ça marche ?</h2>
			<div class="row text-center">
				<div class="col-md-3 mb-4">
					<div class="card h-100 shadow-sm border-0">
						<div class="card-body">
							<h5 class="card-title">1. Inscription</h5>
							<p class="card-text">Créez votre compte étudiant ou enseignant en quelques clics.</p>
						</div>
					</div>
				</div>
				<div class="col-md-3 mb-4">
					<div class="card h-100 shadow-sm border-0">
						<div class="card-body">
							<h5 class="card-title">2. Proposer / Choisir</h5>
							<p class="card-text">Proposez un projet ou sélectionnez ceux qui vous plaisent.</p>
						</div>
					</div>
				</div>
				<div class="col-md-3 mb-4">
					<div class="card h-100 shadow-sm border-0">
						<div class="card-body">
							<h5 class="card-title">3. Attribution</h5>
							<p class="card-text">L’algorithme assigne les projets de façon optimale et équitable.</p>
						</div>
					</div>
				</div>
				<div class="col-md-3 mb-4">
					<div class="card h-100 shadow-sm border-0">
						<div class="card-body">
							<h5 class="card-title">4. Démarrage</h5>
							<p class="card-text">Vous recevez votre projet et commencez à travailler dessus !</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Projets récents -->
	<section class="py-5 bg-light">
		<div class="container mt-5">
			<h2 class="text-center mb-4">Derniers projets disponibles</h2>
			<div class="row">
				{% for projet in projets %}
					<div class="col-md-4">
						<div class="card mb-4 shadow-sm border-0">
							<div class="card-body">
								<h5 class="card-title">{{ projet.intitule }}</h5>
								<p class="card-text">{{ projet.description[:100] }}...</p>
								<a href="{{ path('projet_detail', { id: projet.id }) }}" class="btn btn-outline-primary rounded-pill px-4 py-2 btn-sm">Voir Détails</a>
							</div>
						</div>
					</div>
				{% else %}
					<p class="text-center">Aucun projet disponible.</p>
				{% endfor %}
			</div>

			<div class="text-center mt-4">
				<a href="{{ path('projets_index') }}" class="btn btn-outline-primary rounded-pill px-4 py-2 mb-4 btn-sm">Voir tous les projets</a>
			</div>
		</div>
	</section>

	
{% endblock %}
