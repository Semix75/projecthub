{% extends 'base.html.twig' %}

{% block title %}Liste des Projets{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="text-center mb-4 ">Liste des Projets</h1>

    <div class="row">
        {% for projet in projets %}
            <div class="col-md-4 mb-4">
                <div class="card border-light shadow-lg">
                    <div class="card-body">
                        <!-- Affiche le titre du projet -->
                        <h5 class="card-title">{{ projet.intitule }}</h5>
                        <!-- Affiche une description tronquée du projet -->
                        <p class="card-text">{{ projet.description[:100] }}...</p>
                        <div class="d-flex justify-content-between">
                            <!-- Lien pour voir les détails du projet -->
                            <a href="{{ path('projet_detail', { id: projet.id }) }}" class="btn btn-outline-primary rounded-pill btn-sm">Voir Détails</a>
                            <!-- Bouton pour ajouter ou retirer le projet des favoris -->
                            <button class="btn {% if projet in favoris %}btn-danger{% else %}btn-outline-danger{% endif %} rounded-pill btn-sm" data-id="{{ projet.id }}">
                                {% if projet in favoris %}Retirer des favoris{% else %}Ajouter aux favoris{% endif %}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <!-- Message affiché si aucun projet n'est disponible -->
            <p class="text-center text-muted">Aucun projet disponible.</p>
        {% endfor %}
    </div>
</div>

<script>
    // Ajoute un gestionnaire d'événements pour chaque bouton
    document.querySelectorAll('.btn').forEach(button => {
        button.addEventListener('click', function () {
            let projetId = this.dataset.id; // Récupère l'ID du projet
            let button = this;

            // Envoie une requête AJAX pour ajouter ou retirer le projet des favoris
            fetch('/favoris/toggle/' + projetId, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                // Met à jour l'apparence du bouton en fonction de la réponse
                if (data.status === 'added') {
                    button.classList.remove('btn-outline-danger');
                    button.classList.add('btn-danger');
                    button.textContent = 'Retirer des favoris';
                } else {
                    button.classList.remove('btn-danger');
                    button.classList.add('btn-outline-danger');
                    button.textContent = 'Ajouter aux favoris';
                }
            })
            .catch(error => console.error('Erreur:', error)); // Gère les erreurs
        });
    });
</script>

{% endblock %}
