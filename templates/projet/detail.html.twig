{% extends 'base.html.twig' %}

{% block title %}{{ projet.intitule }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>{{ projet.intitule }}</h1>

    <p><strong>Description :</strong> {{ projet.description }}</p>
    <p><strong>Places disponibles :</strong> {{ projet.nbPlace }}</p>

    <a href="{{ path('projets_index') }}" class="btn btn-secondary">Retour à la liste</a>
</div>
{% endblock %}
