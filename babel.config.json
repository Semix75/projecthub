{
    "presets": [
       ["@babel/preset-env", {
           "targets": {
               "node": "current"
           },
           "module": false,
           "useBuiltIns": false,
           "corejs": null
           }]
    ],
    "plugins": [
        ["@babel/plugin-transform-react-jsx", {
            "pragma": "h",
            "pragmaFrag": "Fragment"
        }],
        [
            "@babel-plugin-jsx-pragmatic",
            {
                "module": "preact",
                "import": "h, Fragment",
                "export": "h, Fragment"
            }
        ]
    ],

    "env": {
        "test": {
            "presets": [
                ["@babel/preset-env"]
            ]
        }
    
    }

}